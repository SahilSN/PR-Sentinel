# Copy to .env (gitignored) or export in your shell. Never commit real values.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# low | medium | high | xhigh | max
ANTHROPIC_EFFORT=medium
# Server-side refusal fallback on supported models: on | off
ANTHROPIC_FALLBACKS=on
GITHUB_TOKEN=
# Login that authors the bot comment. In Actions this is github-actions[bot] (auto-detected).
# When publishing locally with a personal token, it is detected from the token too.
PR_SENTINEL_BOT_LOGIN=

MAX_AGENT_STEPS=6
MAX_TOOL_CALLS=10
MAX_LLM_CALLS=7
MAX_TOTAL_TOKENS=60000
MAX_RUNTIME_SECONDS=120
MAX_FILES=15
MAX_FILE_CHARS=16000
MAX_DIFF_CHARS=30000
MAX_IDENTICAL_TOOL_REQUESTS=1
